PORT=5001

# VoltCred GraphQL API
# Staging:    https://api-stage.voltcred.com/v2/graphql
# Production: https://api.voltcred.com/v2/graphql
VOLTCRED_GRAPHQL_URL=https://api-stage.voltcred.com/v2/graphql
VOLTCRED_EMAIL=hello@optimotion.in
VOLTCRED_PASSWORD=your_password_here

# Renewals API for auto-cutoff
RENEWALS_API_URL=https://api.optimotion.in/api/v1/finance/renewals/list
RENEWALS_LOGIN_URL=https://dashboard.optimotion.in/api/login
RENEWALS_API_USERNAME=your-phone-number
RENEWALS_API_PASSWORD=your-password

# JWT Secret for authentication (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=change-me-to-a-secure-random-string

# GetGabs WhatsApp Notification API
GETGABS_API_KEY=your-getgabs-api-key
GETGABS_API_URL=https://app.getgabs.com/whatsappbusiness/send-templated-message
GETGABS_SENDER=your-sender-number-with-91-prefix
GETGABS_CAMPAIGN_ID=your-campaign-id-from-getgabs-panel
GETGABS_TEMPLATE_NAME=overdue_rental_cutoff
GETGABS_TEMPLATE_LANGUAGE=en_US
